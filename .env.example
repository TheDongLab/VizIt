# VizIt Docker configuration
#
#   cp .env.example .env
#   docker compose up -d --build
#

# --- Ports and runtime -------------------------------------------------------

# Portal address: http://localhost:8080
VIZIT_PORT=8080

# NOTE: UVICORN_HOST / UVICORN_PORT from backend/settings.py have no effect
# here. Inside the container the backend always binds 0.0.0.0:8000, which only
# the bundled Nginx reaches; VIZIT_PORT above is the port you actually access.

# Uvicorn worker processes
UVICORN_WORKERS=4

# FastAPI debug mode
DEBUG=false

# The backend runs as this uid:gid and must be able to write the data
# directories below. Match your host user: `id -u` and `id -g`.
VIZIT_UID=1000
VIZIT_GID=1000

# --- Data locations ----------------------------------------------------------
# Processed datasets served by the app
VIZIT_DATASETS_DIR=./backend/datasets

# Sample sheet CSVs imported by `refresh_db`
VIZIT_SAMPLESHEETS_DIR=./backend/SampleSheets

# Metadata database
DATABASE_URL=sqlite:////data/bdp_db.db

# --- Remote datasets ---------------------------------------------------------
# Lets users load a dataset from a URL instead of the local datasets directory
ALLOW_REMOTE_DATASETS=true

# Comma-separated hostname allowlist; empty allows any public host
REMOTE_DATASET_ALLOWED_HOSTS=

# Permit URLs resolving to private/loopback addresses
REMOTE_DATASET_ALLOW_PRIVATE=false

# --- Reverse proxy -----------------------------------------------------------
# Upstream timeout for remote dataset requests
VIZIT_PROXY_TIMEOUT=600s

# --- Frontend branding -------------------------------------------------------
# Branding (requires rebuild)
VITE_APP_TITLE=
VITE_APP_SUBTITLE=

# Folder under frontend/src/pages/ to use as the home page (e.g. Home, Home_BDP)
VITE_HOME_PAGE=

# Only set this if you are pointing the SPA at a separate backend
VITE_BACKEND_URL=
